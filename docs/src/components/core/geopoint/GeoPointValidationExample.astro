---
import { Code } from '@astrojs/starlight/components';

interface Props {
  latitude?: number;
  longitude?: number;
}

const {
  latitude = 35.6812,
  longitude = 181.5,
} = Astro.props;

const code = `let input = GeoPoint(latitude: ${latitude}, longitude: ${longitude})

if input.isValid() {
    Marker(position: input)
} else {
    Marker(position: input.normalize())
}`;
---

<Code code={code} lang="swift" />
