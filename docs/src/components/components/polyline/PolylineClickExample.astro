---
import { Code } from '@astrojs/starlight/components';

interface Props {
  commentForClick?: string;
  strokeWidth?: number;
}

const {
  commentForClick = "Polyline clicked at",
  strokeWidth = 4,
} = Astro.props;

const code = `Polyline(
    points: route,
    strokeColor: .blue,
    strokeWidth: ${strokeWidth},
    onClick: { event in
        print("${commentForClick} \\(event.clicked)")
    }
)`;
---

<Code code={code} lang="swift" />
