---
import { Code } from '@astrojs/starlight/components';

interface Props {
  latitude?: number;
  longitude?: number;
  zoomLevel?: number;
}

const {
  latitude = 35.6812,
  longitude = 139.7671,
  zoomLevel = 14,
} = Astro.props;

const code = `import heresdk

if let holder = mapViewState.getMapViewHolder(),
   let mapView = holder.mapView as? MapView {
    mapView.camera.lookAt(
        point: GeoCoordinates(latitude: ${latitude}, longitude: ${longitude}),
        zoom: MapMeasure(kind: .zoomLevel, value: ${zoomLevel})
    )
}`;
---

<Code code={code} lang="swift" />
