---
import { Code } from '@astrojs/starlight/components';

interface Props {
  swLat?: number;
  swLon?: number;
  neLat?: number;
  neLon?: number;
}

const {
  swLat = 35.66,
  swLon = 139.73,
  neLat = 35.70,
  neLon = 139.77,
} = Astro.props;

const code = `groundImageState.bounds = GeoRectBounds(
    southWest: GeoPoint(latitude: ${swLat}, longitude: ${swLon}),
    northEast: GeoPoint(latitude: ${neLat}, longitude: ${neLon})
)`;
---

<Code code={code} lang="swift" />
