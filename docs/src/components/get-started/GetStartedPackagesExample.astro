---
import { Code } from '@astrojs/starlight/components';

interface Props {
  coreVersion?: string;
  mapkitVersion?: string;
}

const {
  coreVersion = "{CORE_MODULE_VERSION}",
  mapkitVersion = "{MAPKIT_MODULE_VERSION}",
} = Astro.props;

const code = `.package(url: "https://github.com/MapConductor/ios-sdk-core", from: "${coreVersion}"),
.package(url: "https://github.com/MapConductor/ios-for-mapkit", from: "${mapkitVersion}")`;
---

<Code code={code} lang="swift" />
