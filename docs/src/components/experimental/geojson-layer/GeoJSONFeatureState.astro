---
import { Code } from '@astrojs/starlight/components';

interface Props {
  commentToggle?: string;
}

const {
  commentToggle = "Toggle a feature's visibility",
} = Astro.props;

const code = `let featureStates = features.map { GeoJSONFeatureState(feature: $0) }
GeoJSONLayer(state: layerState, features: featureStates.map { $0.toFeature() })

// ${commentToggle}
featureStates[0].visible = false`;
---

<Code code={code} lang="swift" />
