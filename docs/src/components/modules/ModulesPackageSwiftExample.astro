---
import { Code } from '@astrojs/starlight/components';

interface Props {
  coreVersion?: string;
  googlemapsVersion?: string;
}

const {
  coreVersion = "{CORE_MODULE_VERSION}",
  googlemapsVersion = "{GOOGLEMAPS_MODULE_VERSION}",
} = Astro.props;

const code = `dependencies: [
    .package(url: "https://github.com/MapConductor/ios-sdk-core", from: "${coreVersion}"),
    .package(url: "https://github.com/MapConductor/ios-for-googlemaps", from: "${googlemapsVersion}"),
],
targets: [
    .target(
        name: "App",
        dependencies: [
            .product(name: "MapConductorCore", package: "ios-sdk-core"),
            .product(name: "MapConductorForGoogleMaps", package: "ios-for-googlemaps"),
        ]
    )
]`;
---

<Code code={code} lang="swift" />
